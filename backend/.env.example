PORT=4000
NODE_ENV=development
JWT_SECRET=dev_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_rag_db

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Internal AI Service URL and Key
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=dev_secret_internal_key

# CORS Settings
FRONTEND_URL=http://localhost:5173
